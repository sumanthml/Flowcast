# ==============================================================================
# FlowCast TOC - Environment Variables
# Copy this file to .env.local and configure your credentials.
# The platform runs 100% locally with rich sample retail data if keys are blank!
# ==============================================================================

# 1. Supabase (Primary Hosted Backend & Row-Level Security)
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Groq AI Keys (Server-Side Only - Never Exposed to Browser)
# Obtain from https://console.groq.com/keys
# - GROQ_CHATBOT_API_KEY: Conversational natural language inventory assistant
GROQ_CHATBOT_API_KEY=gsk_your_chatbot_key_here

# - GROQ_INSIGHTS_API_KEY: Strategic executive inventory & capital risk audit
GROQ_INSIGHTS_API_KEY=gsk_your_insights_key_here

# Optional: Default App Host
NEXT_PUBLIC_APP_NAME="FlowCast TOC Inventory Planning"
